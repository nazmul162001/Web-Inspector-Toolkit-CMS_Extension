{
  "manifest_version": 3,
  "name": "Web Inspector Toolkit",
  "version": "1.0.0",
  "description": "A developer toolkit in Chrome's side panel. Color Find locates every element, CSS rule and variable that uses a given color - on this page or across a whole site.",
  "minimum_chrome_version": "120",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Open Web Inspector Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "storage", "offscreen"],

  "optional_host_permissions": ["http://*/*", "https://*/*"],

  "web_accessible_resources": [
    {
      "resources": [
        "content/*.js",
        "services/color-*.js",
        "services/text-*.js",
        "services/phone-*.js",
        "services/href-*.js",
        "services/font-*.js",
        "services/width-*.js",
        "services/image-*.js",
        "services/message-service.js",
        "shared/*.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
